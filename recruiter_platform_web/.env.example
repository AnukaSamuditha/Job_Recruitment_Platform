# Copy to `.env.local` for local dev.

# Option A — full URL (takes precedence if set). Prefer 127.0.0.1 over localhost on Windows
# so HTTP and WebSocket match Uvicorn’s IPv4 listen address.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional — if the WS endpoint differs from API_BASE (e.g. reverse proxy), set explicitly:
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Option B — compose URL (used when NEXT_PUBLIC_API_URL is unset):
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=127.0.0.1
NEXT_PUBLIC_API_PORT=8000
