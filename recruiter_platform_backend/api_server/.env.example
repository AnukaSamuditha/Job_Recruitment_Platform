DB_URL=postgresql+asyncpg://recruit:recruit@127.0.0.1:5433/recruitment
PORT=8000
GRPC_PORT=50051
GRPC_BIND_HOST=0.0.0.0
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: regex for dev (any port on localhost / 127.0.0.1 / ::1). Set empty to disable.
# CORS_ALLOW_ORIGIN_REGEX=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cvs
MINIO_USE_SSL=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# LlamaCloud — CV PDF parsing (https://cloud.llamaindex.ai → API keys)
LLAMA_CLOUD_API_KEY=
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# Optional multi-tenant query params (only if your LlamaCloud project requires them):
# LLAMA_CLOUD_ORGANIZATION_ID=
# LLAMA_CLOUD_PROJECT_ID=
# LLAMA_CLOUD_PARSE_TIMEOUT_SECONDS=900
# CV structured extraction always uses MCP tool ``parse_candidate_cv_structured`` (LlamaCloud runs on the MCP server).
# Use ``.../mcp`` without a trailing slash (FastMCP 307-redirects ``/mcp/`` → ``/mcp``, which breaks the MCP client).
# API in Docker reaching host MCP: http://host.docker.internal:8765/mcp
MCP_CV_TOOLS_URL=http://127.0.0.1:8765/mcp
# When true (default), the API spawns MCP on that loopback port after gRPC starts (needs ``uv`` on PATH + mcp_server/.env).
# MCP_CV_AUTO_START=false
# CV preview (PDF → PNG data URLs): max pages and raster width
# CV_PREVIEW_MAX_PAGES=15
# CV_PREVIEW_MAX_WIDTH_PX=1100

# Agent traces (inputs, tool_calls, outputs) — one JSON object per line under api_server/logs/
# TRACE_LOG_TO_FILES=true
# TRACE_LOG_DIR=logs