# Copy to mcp_server/.env

# Match api_server GRPC_PORT / bind address on the machine running the API.
API_GRPC_HOST=127.0.0.1
API_GRPC_PORT=50051

# Optional: full target (overrides host + port when set).
# API_GRPC_TARGET=127.0.0.1:50051

# LlamaCloud — required for ``parse_candidate_cv_structured`` (same as api_server ingest).
LLAMA_CLOUD_API_KEY=
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# LLAMA_CLOUD_ORGANIZATION_ID=
# LLAMA_CLOUD_PROJECT_ID=
# LLAMA_CLOUD_PARSE_TIMEOUT_SECONDS=900
